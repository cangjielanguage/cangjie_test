let RED: Array<LlCase> = [
    LlCase("HTTP 100 first, then 400", "ACCEPT", ""),
    LlCase("Response starting with CRLF", "ACCEPT", "0d0a485454502f312e3120323030204f4b0d0a486561646572313a2056616c7565310d0a486561646572323a092056616c7565320d0a436f6e74656e742d4c656e6774683a20300d0a0d0a0d0a"),

]

func llStartRawSrv(hex: String): TcpServerSocket {
    let listener = TcpServerSocket(bindAt: 0)
    listener.bind()
    spawn {
        while (true) {
            try {
                let sock = listener.accept()
                spawn {
                    try {
                        sock.write(llHexToBytes(hex))
                        sleep(Duration.millisecond * 300)
                        sock.close()
                    } catch (e: Exception) { () }
                }
            } catch (e: Exception) { return }
        }
    }
    return listener
}

func llPortOf(listener: TcpServerSocket): Int64 {
    var port: Int64 = 0
    while (port == 0) {
        sleep(Duration.millisecond)
        let t = listener.localAddress.toString()
        match (t.lastIndexOf(":")) {
            case Some(i) => port = Int64.parse(t[i + 1..])
            case None => ()
        }
    }
    return port
}

func llFeedResponse(hex: String): (Bool, String) {
    let listener = llStartRawSrv(hex)
    let port = llPortOf(listener)
    let c = ClientBuilder().autoRedirect(false).readTimeout(2 * Duration.second).build()
    var accepted = false
    var detail = ""
    try {
        let r = c.get("http://127.0.0.1:" + port.toString() + "/")
        accepted = true
        detail = "status=" + r.status.toString()
    } catch (e: Exception) {
        detail = e.toString()
    }
    c.close()
    listener.close()
    return (accepted, detail)
}

@Test
class LlhttpToleranceResponse {
    @TestCase
    func greenPins(): Unit {
        for (c in GREEN) {
            let (accepted, detail) = llFeedResponse(c.hex)
            println("[llhttp-green] " + c.name + ": expect=" + c.expect + " got=" + detail)
            if (c.expect == "ACCEPT") {
                @Expect(accepted, true)
            } else {
                @Expect(accepted, false)
            }
        }
    }

    @TestCase
    func issue33_redCases(): Unit {
        for (c in RED) {
            let (accepted, detail) = llFeedResponse(c.hex)
            println("[llhttp-red] " + c.name + ": expect=" + c.expect + " got=" + detail)
            if (c.expect == "ACCEPT") {
                @Expect(accepted, true)
            } else {
                @Expect(accepted, false)
            }
        }
    }
}

