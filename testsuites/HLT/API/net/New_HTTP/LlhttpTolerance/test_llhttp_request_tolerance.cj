]

var llHandlerRan = AtomicBool(false)

func llStartServer(): Server {
    let s = ServerBuilder().addr("127.0.0.1").port(0).build()
    s.distributor.register("/", { ctx =>
        llHandlerRan.store(true)
        ctx.responseBuilder.body("R")
    })
    s.distributor.register("/url", { ctx =>
        llHandlerRan.store(true)
        ctx.responseBuilder.body("R")
    })
    spawn { s.serve() }
    while (s.port == 0) { sleep(Duration.millisecond) }
    return s
}

func llSendRaw(port: Int64, hex: String): (Bool, String) {
    llHandlerRan.store(false)
    let sock = TcpSocket("127.0.0.1", UInt16(port))
    sock.connect()
    sock.write(llHexToBytes(hex))
    spawn {
        sleep(Duration.millisecond * 300)
        try { sock.close() } catch (e: Exception) { () }
    }
    sleep(Duration.millisecond * 120)
    var replyLen = 0
    let buf = Array<UInt8>(4096, repeat: 0)
    while (true) {
        var n = 0
        var err = false
        try { n = sock.read(buf) } catch (e: Exception) { err = true }
        if (err || n <= 0) { break }
        replyLen = replyLen + n
    }
    sock.close()
    var status = ""
    if (replyLen >= 12) {
        var headLen = replyLen
        if (headLen > 64) { headLen = 64 }
        let head = String.fromUtf8(buf[0..headLen])
        if (head.startsWith("HTTP/1.")) {
            match (head.indexOf(" ")) {
                case Some(p1) =>
                    match (head.indexOf(" ", p1 + 1)) {
                        case Some(p2) => status = head[p1 + 1..p2]
                        case None => ()
                    }
                case None => ()
            }
        }
    }
    let parsed = (llHandlerRan.load() && status == "200") || status == "404"
    return (parsed, status)
}

@Test
class LlhttpToleranceRequest {
    @TestCase
    func greenPins(): Unit {
        let s = llStartServer()
        for (c in GREEN) {
            let (parsed, status) = llSendRaw(Int64(s.port), c.hex)
            println("[llhttp-green] " + c.name + ": expect=" + c.expect + " parsed=" + parsed.toString() + " status=" + status)
            if (c.expect == "ACCEPT") {
                @Expect(parsed, true)
            } else {
                @Expect(parsed, false)
            }
        }
        s.close()
    }

    @TestCase
    func issue32_33_redCases(): Unit {
        let s = llStartServer()
        for (c in RED) {
            let (parsed, status) = llSendRaw(Int64(s.port), c.hex)
            println("[llhttp-red] " + c.name + ": expect=" + c.expect + " parsed=" + parsed.toString() + " status=" + status)
            if (c.expect == "ACCEPT") {
                @Expect(parsed, true)
            } else {
                @Expect(parsed, false)
            }
        }
        s.close()
    }
}

