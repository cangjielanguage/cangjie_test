    LlCase("Only LFs present (lenient)", "REJECT", "504f5354202f20485454502f312e310a5472616e736665722d456e636f64696e673a206368756e6b65640a547261696c65723a2042617a0d0a486f73743a206578616d706c652e636f6d0d0a466f6f3a206162630a4261723a206465660a0a310a410a313b6162630a420a313b6465663d6768690a430a313b6a6b6c3d226d6e6f220a440a300a0a42617a3a206768690a0a0d0a"),
