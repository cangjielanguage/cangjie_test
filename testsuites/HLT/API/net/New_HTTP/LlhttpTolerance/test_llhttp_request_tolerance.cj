func llHexToBytes(hex: String): Array<UInt8> {
    let out = ArrayList<UInt8>()
    var i = 0
    while (i + 1 < hex.size) {
        let hi = hex[i]
        let lo = hex[i + 1]
        let h = match (hi) {
            case '0' => 0u8 case '1' => 1u8 case '2' => 2u8 case '3' => 3u8
            case '4' => 4u8 case '5' => 5u8 case '6' => 6u8 case '7' => 7u8
            case '8' => 8u8 case '9' => 9u8 case 'a' => 10u8 case 'b' => 11u8
            case 'c' => 12u8 case 'd' => 13u8 case 'e' => 14u8 case 'f' => 15u8
            case _ => 0u8
        }
        let l = match (lo) {
            case '0' => 0u8 case '1' => 1u8 case '2' => 2u8 case '3' => 3u8
            case '4' => 4u8 case '5' => 5u8 case '6' => 6u8 case '7' => 7u8
            case '8' => 8u8 case '9' => 9u8 case 'a' => 10u8 case 'b' => 11u8
            case 'c' => 12u8 case 'd' => 13u8 case 'e' => 14u8 case 'f' => 15u8
            case _ => 0u8
        }
        out.add(h * 16u8 + l)
        i = i + 2
    }
    return out.toArray()
}

class LlCase {
    let name: String
    let expect: String   // ACCEPT | REJECT (llhttp strict semantics)
    let hex: String
    init(n: String, e: String, h: String) { name = n; expect = e; hex = h }
}

