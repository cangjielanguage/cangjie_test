/*
*- @TestCaseID: TC-3
*- @TestCaseName: std.reflect — TupleTypeInfo (基础) — Tuple_tpl_2_i64_i64
*- @TestCaseType: 功能测试
*- @Design Description: Rule 驱动：combo Tuple_tpl_2_i64_i64（typeVariant × acquisitionPath）
*- @Condition: 用例的预置条件
*   -#仓颉工具链环境已正确安装
*   -#元组为语言内建类型，无需上游自定义类型（Point 除外）
*- @Brief: 描述测试步骤
*   -#通过获取路径拿到 TupleTypeInfo
*   -#按 Rule 预言验证 elements/construct/destruct/name/继承面行为
*- @Expect: 用例的预期结果
*   -#所有@Expect断言通过，Rule 预期与官方 doc-libs 契约一致
*- @Priority: P0
*/

// Description:
// DEPENDENCE: upstream utils
// EXEC: %compiler %cmp_opt %compile_lib_opt -p upstream
// EXEC: %compiler %cmp_opt %compile_lib_opt -p utils
// EXEC: %compiler %cmp_opt %f -L . -lupstream -lutils -o %output %cmp_utest_opt
// RUN-EXEC: %run %run_opt %output %run_utest_opt %run_args

import std.unittest.*
import std.unittest.common.*
import std.unittest.testmacro.*
import std.reflect.*
import std.collection.*
import upstream.*
import utils.*
@Test
class TestTupleBasic {
    @TestCase
    func testCase0(): Unit {
        @Expect(TupleTypeInfo.of((1, 2)).name, "Tuple<Int64, Int64>")
        @Expect(TupleTypeInfo.of((1, 2)).qualifiedName.size > 0i64, true)
        @Expect[tupleSuperInterfacesHasAny](TupleTypeInfo.of((1, 2)).superInterfaces, ["Any"])
        @Expect[tupleElements](TupleTypeInfo.of((1, 2)).elements, ["Int64", "Int64"])
        @Expect(TupleTypeInfo.of((1, 2)).hashCode() == TupleTypeInfo.of((1, 2)).hashCode(), true)
        @Expect(TupleTypeInfo.of((1, 2)).toString() != "", true)
        @Expect(TupleTypeInfo.of((1, 2)) == TupleTypeInfo.of((1, 2)), true)
        @Expect(TupleTypeInfo.of((1, 2)).isSubtypeOf(InterfaceTypeInfo.get("Any")), true)
        @Expect[emptyCollection](TupleTypeInfo.of((1, 2)).instanceFunctions, [])
        @Expect[emptyCollection](TupleTypeInfo.of((1, 2)).staticFunctions, [])
        @Expect[emptyCollection](TupleTypeInfo.of((1, 2)).instanceProperties, [])
        @Expect[emptyCollection](TupleTypeInfo.of((1, 2)).staticProperties, [])
        @Expect[emptyCollection](TupleTypeInfo.of((1, 2)).modifiers, [])
        @ExpectThrows[InfoNotFoundException](TupleTypeInfo.of((1, 2)).getInstanceFunction("anyFunction", []))
        @Expect[strArrayContent](TupleTypeInfo.of((1, 2)).getInstanceFunctions("anyFunction"), [])
        @ExpectThrows[InfoNotFoundException](TupleTypeInfo.of((1, 2)).getInstanceProperty("anyFunction"))
        @ExpectThrows[InfoNotFoundException](TupleTypeInfo.of((1, 2)).getStaticFunction("anyFunction", []))
        @Expect[strArrayContent](TupleTypeInfo.of((1, 2)).getStaticFunctions("anyFunction"), [])
        @ExpectThrows[InfoNotFoundException](TupleTypeInfo.of((1, 2)).getStaticProperty("anyFunction"))
        @Expect[anyValue](TupleTypeInfo.of((1, 2)).construct([1, 2]), (1, 2))
        @Expect[tupleElementsList](TupleTypeInfo.of((1, 2)).destruct((1, 2)), [1, 2])
        @Expect(TupleTypeInfo.of((1, 2)) != TupleTypeInfo.of((1, 2, "x")), true)
        @Expect(TupleTypeInfo.of((1, 2)) == TupleTypeInfo.of((1, 2, "x")), false)
    }

}

