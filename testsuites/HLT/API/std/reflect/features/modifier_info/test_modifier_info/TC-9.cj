/*
*- @TestCaseID: TC-9
*- @TestCaseName: std.reflect — ModifierInfo — RedefStatic × modifiersCollection
*- @TestCaseType: 功能测试
*- @Design Description: 基于反射API等价类划分方法，消费 Rule 预言，验证 ModifierInfo 枚举语义与 modifiers 集合语义
*- @Condition: 用例的预置条件
*   -#仓颉工具链环境已正确安装
*   -#被测类型的源文件已编译为动态库
*- @Brief: 描述测试步骤
*   -#经被测类型的反射信息对象获取 modifiers 集合 / 直接引用 ModifierInfo 枚举值
*   -#通过 Rule 预言验证 toString/hashCode/==/!= 与 modifiers 集合的空集/元素/定义序/语义包含条款
*- @Expect: 用例的预期结果
*   -#所有@Expect断言通过，反射API返回值与Rule预言一致
*- @Priority: P0
*/

// Description:
// DEPENDENCE: utils redefpkg upstream
// EXEC: %compiler %cmp_opt %compile_lib_opt -p utils
// EXEC: %compiler %cmp_opt %compile_lib_opt -p redefpkg
// EXEC: %compiler %cmp_opt %compile_lib_opt -p upstream
// EXEC: %compiler %cmp_opt %f -L . -lutils -lupstream -lredefpkg -o %output %cmp_utest_opt
// RUN-EXEC: %run %run_opt %output %run_utest_opt %run_args

import std.unittest.*
import std.unittest.common.*
import std.unittest.testmacro.*
import utils.*
import upstream.*
import std.reflect.*
@Test
class TestModifierInfo {
    @TestCase
    func testCase0(): Unit {
        @Expect(ClassTypeInfo.get("upstream.RedefChild").getStaticFunction("rsf").modifiers.toArray().size, 2i64)
        @Expect[anyValue](ClassTypeInfo.get("upstream.RedefChild").getStaticFunction("rsf").modifiers.toArray().contains(ModifierInfo.Redef) && ClassTypeInfo.get("upstream.RedefChild").getStaticFunction("rsf").modifiers.toArray().contains(ModifierInfo.Static), true)
        @Expect(ClassTypeInfo.get("upstream.RedefChild").getStaticFunction("rsf").modifiers.toArray().get(0i64).getOrThrow().toString(), "redef")
        @Expect(ClassTypeInfo.get("upstream.RedefChild").getStaticFunction("rsf").modifiers.toArray().get(1i64).getOrThrow().toString(), "static")
        @Expect(ClassTypeInfo.get("upstream.RedefChild").modifiers.toArray().size == 0i64, true)
    }

}

