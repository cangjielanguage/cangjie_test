/*
*- @TestCaseID: TC-4
*- @TestCaseName: std.reflect — FunctionTypeInfo (函数引用) — AllApis_gsm_sgenPair
*- @TestCaseType: 功能测试
*- @Design Description: Rule 驱动：combo AllApis_gsm_sgenPair（typeVariant × acquisitionPath）
*- @Condition: 用例的预置条件
*   -#仓颉工具链环境已正确安装
*   -#被测函数值已编译进 upstream 动态库
*- @Brief: 描述测试步骤
*   -#通过获取路径拿到 FunctionTypeInfo
*   -#按 Rule 预言验证属性/继承/调用/相等行为
*- @Expect: 用例的预期结果
*   -#所有@Expect断言通过，Rule 预期与官方 doc-libs 契约一致
*- @Priority: P0
*/

// Description:
// DEPENDENCE: upstream utils
// EXEC: %compiler %cmp_opt %compile_lib_opt -p upstream
// EXEC: %compiler %cmp_opt %compile_lib_opt -p utils
// EXEC: %compiler %cmp_opt %f -L . -lupstream -lutils -o %output %cmp_utest_opt
// RUN-EXEC: %run %run_opt %output %run_utest_opt %run_args

import std.unittest.*
import std.unittest.common.*
import std.unittest.testmacro.*
import std.reflect.*
import std.collection.*
import std.sort.*
import upstream.*
import utils.*
@Test
class TestFtiRef {
    @TestCase
    func testCase0(): Unit {
        @Expect[paramTypeNames](FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).parameters, ["Int64", "Float64"])
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).returnType.name, "Float64")
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).name != "", true)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).qualifiedName != "", true)
        @Expect[annotations](FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).annotations, [])
        @Expect[notContainsModifiers](FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).modifiers, ["open", "abstract", "sealed"])
        @Expect[containsIfaceName](FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).superInterfaces, "Any")
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).instanceFunctions.toArray().size, 0i64)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).instanceProperties.toArray().size, 0i64)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).staticFunctions.toArray().size, 0i64)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).staticProperties.toArray().size, 0i64)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).findAnnotation<Tag>().isNone(), true)
        @Expect[annotationsArray](FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).findAllAnnotations<Tag>(), [])
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).getAllAnnotations().toArray().size, 0i64)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).isSubtypeOf(TypeInfo.of<Any>()), true)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).hashCode() == FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).hashCode(), true)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).toString() != "", true)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>) == FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>), true)
        @Expect(!(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>) != FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>)), true)
        @Expect[anyValue](FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>).apply(GtiGenStatic.gtiGenPair<Int64, Float64>, [1, 2.5f64]), 2.5f64)
        @Expect(!(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>) == FunctionTypeInfo.of<(Int64, Float64) -> String>()), true)
        @Expect(FunctionTypeInfo.of(GtiGenStatic.gtiGenPair<Int64, Float64>) != FunctionTypeInfo.of<(Int64, Float64) -> String>(), true)
    }

}

