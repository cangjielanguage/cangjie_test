/*
 * - @TestCaseID: TC-6
 * - @TestCaseName: std.reflect — StructTypeInfo — MultiCtorStruct
 * - @TestCaseType: 功能测试
 * - @Design Description: 基于反射API等价类划分方法，验证Struct with multiple constructors
 * - @Condition: 用例的预置条件
 *   -#仓颉工具链环境已正确安装
 *   -#被测类型的源文件已编译为动态库
 * - @Brief: 描述测试步骤
 *   -#获取TypeInfo引用（byName/byInstance/byTypeArg）
 *   -#通过TypeInfo查询被测类型的成员信息
 *   -#构造实例并读写成员变量/属性
 *   -#调用成员函数并验证返回值
 * - @Expect: 用例的预期结果
 *   -#所有@Expect断言通过，反射API返回值与预期一致
 * - @Priority: P0
 */

// Description:
// DEPENDENCE: utils upstream
// EXEC: %compiler %cmp_opt %compile_lib_opt -p utils
// EXEC: %compiler %cmp_opt %compile_lib_opt -p upstream
// EXEC: %compiler %cmp_opt %f -L . -lutils -lupstream -o %output %cmp_utest_opt
// RUN-EXEC: %run %run_opt %output %run_utest_opt %run_args

import std.unittest.*
import std.unittest.common.*
import std.unittest.testmacro.*
import utils.*
import upstream.*
import std.reflect.*

@Test
class TestStruct {
    @TestCase
    func testCase0(): Unit {
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").name != "")
        @Expect[anyValue](StructTypeInfo.get("upstream.MultiCtorStruct").toString(), StructTypeInfo.get("upstream.MultiCtorStruct").qualifiedName)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").constructors.toArray().size, 4i64)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([]).toString() != "")
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String")]).toString() != "")
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String"), PrimitiveTypeInfo.get("Int64")]).toString() != "")
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String"), PrimitiveTypeInfo.get("Int64"), PrimitiveTypeInfo.get("Bool")]).toString() != "")
        @Expect[anyValue](StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([]).apply([]), StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([]).apply([]))
        @Expect[anyValue](StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String")]).apply(["hello"]), StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String")]).apply(["hello"]))
        @Expect[anyValue](StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String"), PrimitiveTypeInfo.get("Int64")]).apply(["hello", 1i64]), StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String"), PrimitiveTypeInfo.get("Int64")]).apply(["hello", 1i64]))
        @Expect[anyValue](StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String"), PrimitiveTypeInfo.get("Int64"), PrimitiveTypeInfo.get("Bool")]).apply(["hello", 1i64, true]), StructTypeInfo.get("upstream.MultiCtorStruct").getConstructor([StructTypeInfo.get("std.core.String"), PrimitiveTypeInfo.get("Int64"), PrimitiveTypeInfo.get("Bool")]).apply(["hello", 1i64, true]))
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").instanceVariables.toArray().size, 3i64)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getInstanceVariable("name").name, "name")
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getInstanceVariable("name").isMutable(), true)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getInstanceVariable("value").name, "value")
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getInstanceVariable("value").isMutable(), true)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getInstanceVariable("flag").name, "flag")
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").getInstanceVariable("flag").isMutable(), true)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").staticVariables.toArray().size, 0i64)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").instanceFunctions.toArray().size, 0i64)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").staticFunctions.toArray().size, 0i64)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").instanceProperties.toArray().size, 0i64)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").staticProperties.toArray().size, 0i64)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").annotations.toArray().size, 0i64)
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").hashCode() == StructTypeInfo.get("upstream.MultiCtorStruct").hashCode())
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct") == StructTypeInfo.get("upstream.MultiCtorStruct"))
        @ExpectThrows[InfoNotFoundException](StructTypeInfo.get("std.core.Int64"))
        @Expect(StructTypeInfo.get("upstream.MultiCtorStruct").qualifiedName, "upstream.MultiCtorStruct")
        @ExpectThrows[InfoNotFoundException](StructTypeInfo.get("upstream.MultiCtorStruct").construct([0i64, 0i64, 0i64]))
    }
}
