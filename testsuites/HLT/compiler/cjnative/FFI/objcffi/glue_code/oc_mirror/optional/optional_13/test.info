// Level: 1
// Description:
// @ObjC静态成员函数形参class类型，传入Some
// DEPENDENCE: src test.toml
// (iOSNative) EXEC: %mirror_gen test.toml
// (iOSNative and not iOS) EXEC: %clang --shared -Isrc/objc src/objc/G.m -o libdep.dylib
// (iOSNative and iOS) EXEC: xcrun --sdk iphonesimulator %clang -fobjc-arc -framework Foundation -lobjc -Wl,-install_name,@rpath/libdep.dylib --target=%clang_target --sysroot=$(xcrun --show-sdk-path --sdk iphonesimulator) --shared -Isrc/objc src/objc/G.m -o libdep.dylib
// (iOSNative) EXEC: %compiler %compile_dylib_opt %cmp_ocffi_opt %link_oc --link-options="-install_name @rpath/libobjc.foundation.dylib" src/objc/foundation/*.cj
// (iOSNative) EXEC: %compiler %compile_dylib_opt %cmp_ocffi_opt %link_oc -L . -ldep -lobjc.foundation --link-options="-install_name @rpath/libcjworld.dylib" src/cjworld/*.cj
// (iOSNative) EXEC: cd objc-gen && %clang %clang_opt -framework Foundation *.m -I. -I../src/objc -c
// (iOSNative and not iOS) EXEC: %clang %cangjie_runtime_link %clang_link_core %clang_link_objc_interop -fobjc-arc src/objc/*.m objc-gen/*.o -Isrc/objc -Iobjc-gen -L. -lcjworld -o %output
// (iOSNative) RUN-EXEC-PIPE: %run %run_opt %output %run_args 2>&1 | compare %f
// (iOSNative) ASSERT: scan-begin p0.isSome() = true
// (iOSNative) ASSERT: scan-next pFoo
