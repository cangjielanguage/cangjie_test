// EXEC-PIPE-0: export LD_LIBRARY_PATH=$CANGJIE_HOME/tools/lib:$LD_LIBRARY_PATH && %compiler %import-cangjie-stdx %cmp_opt %f -o %output %weave_aspects_plugin
// EXEC-PIPE-0: %set_stdx_path %run %run_opt %output %run_args | compare %f
// ASSERT: scan #----- start -----#\n#----- original -----#\n#----- end -----#\n42\n
// ASSERT: scan-not core dumped
// ASSERT: scan-not stack trace

import stdx.aspect_cj.*

public class CA {
    @ReplaceFuncBody[packageName: "default", className: "CA", methodName: "foo", isStatic: true,
        recursive: false]
    public static func aspect(x: Int64, original: (Int64) -> Int64): Int64 {
        println("#----- start -----#")
        let r = original(x)
        println("#----- end -----#")
        r
    }

    public static func foo(x: Int64): Int64 {
        println("#----- original -----#")
        x
    }
}

main() {
    println(CA.foo(42))
    0
}
